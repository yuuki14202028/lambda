import "std/prelude"

let testOption(): bool =
  let x: Option[i32] = Some[i32](42) in
  let y: Option[i32] = map[Option][i32][i32](λn: i32. __add_i32(n)(1))(x) in
  match y {
    Some(v) => __eq_i32(v)(43)
    None => false
  }

let testEither(): bool =
  let x: Either[foreign.C.String][i32] = Right[foreign.C.String][i32](10) in
  let y: Either[foreign.C.String][i32] =
    map[Either[foreign.C.String]][i32][i32](λn: i32. __add_i32(n)(5))(x) in
  match y {
    Right(v) => __eq_i32(v)(15)
    Left(_) => false
  }

let testList(): bool =
  let nums: List[i32] = Cons[i32](1)(Cons[i32](2)(Cons[i32](3)(Nil[i32]))) in
  let total: i32 = foldLeft[List][i32][i32](λacc: i32. λx: i32. __add_i32(acc)(x))(0)(nums) in
  __eq_i32(total)(6)

let testListFunctor(): bool =
  let nums: List[i32] = Cons[i32](1)(Cons[i32](2)(Nil[i32])) in
  let doubled: List[i32] = map[List][i32][i32](λx: i32. __mul_i32(x)(2))(nums) in
  let total: i32 = foldRight[List][i32][i32](λx: i32. λacc: i32. __add_i32(x)(acc))(0)(doubled) in
  __eq_i32(total)(6)

let testPair(): bool =
  let p: Pair[foreign.C.String][i32] = Pair[foreign.C.String][i32]("k")(1) in
  let q: Pair[foreign.C.String][i32] =
    map[Pair[foreign.C.String]][i32][i32](λx: i32. __add_i32(x)(9))(p) in
  match q {
    Pair(_)(v) => __eq_i32(v)(10)
  }

let testCompose(): bool =
  let f: i32 → i32 = λx: i32. __add_i32(x)(1) in
  let g: i32 → i32 = λx: i32. __mul_i32(x)(2) in
  let h: i32 → i32 = compose[i32][i32][i32](f)(g) in
  __eq_i32(h(5))(11)

let testMonoid(): bool =
  __eq_i32(append[i32](10)(20))(30)

let testMonadContext(): bool =
  let r: Option[i32] = context[Option] {
    a: i32 = Some[i32](20);
    b: i32 = Some[i32](22);
    __add_i32(a)(b)
  } in
  match r {
    Some(v) => __eq_i32(v)(42)
    None => false
  }

let testOrdDefaults(): bool =
  neq[i32](1)(2) && !neq[i32](3)(3) &&
    leq[i32](2)(2) && leq[i32](1)(2) && !leq[i32](3)(2) &&
    gt[i32](3)(2) && !gt[i32](2)(2) &&
    geq[i32](2)(2) && geq[i32](3)(2) && !geq[i32](1)(2) &&
    lt[f64](1.5)(2.5) && geq[f64](2.5)(2.5) && neq[char]('a')('b')

let testApply(): bool =
  let inc: Option[i32 → i32] = Some[i32 → i32](λn: i32. n + 1) in
  let some: bool = match apply[Option][i32][i32](inc)(Some[i32](1)) {
    Some(2) => true
    _ => false
  } in
  let none: bool = match apply[Option][i32][i32](inc)(None[i32]) {
    None => true
    _ => false
  } in
  let left: bool = match apply[Either[i32]][i32][i32](Right[i32][i32 → i32](λn: i32. n + 1))(Left[i32][i32](7)) {
    Left(7) => true
    _ => false
  } in
  let right: bool = match apply[Either[i32]][i32][i32](Right[i32][i32 → i32](λn: i32. n + 1))(Right[i32][i32](1)) {
    Right(2) => true
    _ => false
  } in
  some && none && left && right

let testChar(): bool =
  Char.isDigit('7') && !Char.isDigit('a') && Char.isLetter('Q') && !Char.isLetter('1') &&
    Char.isSpace(' ') && Char.isSpace('\n') && !Char.isSpace('_') &&
    Char.toUpper('a') == 'A' && Char.toLower('Z') == 'z' && Char.toUpper('1') == '1' &&
    Char.code('A') == 65 && Char.fromCode(48) == '0' &&
    'a' < 'b' && 'b' >= 'b' && lt[char]('a')('b') && geq[char]('z')('a') &&
    (match Char.digit('7') {
      Some(7) => true
      _ => false
    }) &&
    (match Char.digit('x') {
      None => true
      _ => false
    })

let testString(): bool =
  Str.length("hello") == 5 && "ab" + "cd" == "abcd" && "abc" < "abd" && "b" > "a" && "x" != "y" &&
    Str.slice("hello")(1)(3) == "ell" && Str.slice("hello")(3)(10) == "lo" &&
    Str.fromInt(42) == "42" && Str.toInt("17") == 17 &&
    Str.fromList(Str.toList("round")) == "round" &&
    Str.startsWith("he")("hello") && !Str.startsWith("lo")("hello") &&
    Str.isEmpty("") && !Str.isEmpty(" ") &&
    eq[String]("a")("a") && neq[String]("a")("b") && leq[String]("a")("a") &&
    append[String]("a")("b") == "ab" && append[String](empty[String])("z") == "z" &&
    (match Str.charAt("abc")(1) {
      Some('b') => true
      _ => false
    }) &&
    (match Str.charAt("abc")(3) {
      None => true
      _ => false
    })

let testShow(): bool =
  show[i32](42) == "42" && show[bool](true) == "true" && show[char]('x') == "x" && show[String]("s") == "s" &&
    show[unit](()) == "()" && show[i64](7i64) == "7" && show[f64](1.5) == "1.5" &&
    show[Option[i32]](Some[i32](1)) == "Some(1)" && show[Option[bool]](None[bool]) == "None" &&
    show[Either[String][i32]](Left[String][i32]("e")) == "Left(e)" &&
    show[Pair[i32][bool]](Pair[i32][bool](1)(false)) == "(1, false)" &&
    show[List[i32]](Nil[i32]) == "[]" &&
    show[List[i32]](Cons[i32](1)(Cons[i32](2)(Cons[i32](3)(Nil[i32])))) == "[1, 2, 3]" &&
    show[List[Option[i32]]](Cons[Option[i32]](Some[i32](1))(Cons[Option[i32]](None[i32])(Nil[Option[i32]]))) == "[Some(1), None]" &&
    `n = {1}, xs = {Cons[i32](1)(Nil[i32])}, ok = {true}` == "n = 1, xs = [1], ok = true"

let main(): i32 =
  if testOption() then
    if testEither() then
      if testList() then
        if testListFunctor() then
          if testPair() then
            if testCompose() then
              if testMonoid() then
                if testMonadContext() then
                  if testOrdDefaults() then
                    if testApply() then
                      if testChar() then
                        if testString() then
                          if testShow() then 0 else 13
                        else 12
                      else 11
                    else 10
                  else 9
                else 8
              else 7
            else 6
          else 5
        else 4
      else 3
    else 2
  else 1
