import "stdlib/operators"
import "stdlib/functor"

let printStr: foreign.C.String → i32 = foreign[foreign.C.String → i32] printf
let intToStr: i32 → foreign.C.String = foreign[i32 → foreign.C.String] int_to_string

let identity[a](x: a): a = x

data Maybe[a] = { Nothing, Just(a) }

trait Show[a] {
  def show(x: a): foreign.C.String
}

let printf[a](x: a): i32 with Show[a] = printStr(show[a](x))

impl Show[i32] {
  def show = intToStr
}

impl Show[foreign.C.String] {
  def show = identity[foreign.C.String]
}

impl[a] Show[Maybe[a]] with Show[a] {
  def show = λm: Maybe[a]. match m {
    Nothing => "Nothing"
    Just(x) => `Just({show[a](x)})`
  }
}

trait Monad[m: * → *] {
  def pure[a](x: a): m[a]
  def flatMap[a][b](v: m[a])(f: a → m[b]): m[b]
}

impl Monad[Maybe] {
  def pure[a](x: a): m[a] = Just[a](x)
  def flatMap[a][b](m: Maybe[a])(f: a → Maybe[b]): Maybe[b] = match m {
    Nothing => Nothing[b]
    Just(x) => f(x)
  }
}

let safeDiv(x: i32)(y: i32): Maybe[i32] =
  if y == 0 then Nothing[i32] else Just[i32](x / y)

let compute(): Maybe[i32] = context[Maybe] {
  step1: i32 = 120 safeDiv 5;
  step2: i32 = step1 safeDiv 3;
  step2 + 1
}

let main(): i32 = {
  printf[foreign.C.String](`result = {compute()}\n`);
  0
}