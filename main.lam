import "stdlib/operators"
import "stdlib/functor"

let printStr: foreign.C.String → i32 = foreign[foreign.C.String → i32] printf
let intToStr: i32 → foreign.C.String = foreign[i32 → foreign.C.String] int_to_string

let identity[a](x: a): a = x

data Maybe[a] =
  | Nothing
  | Just(a)

trait Show[a] {
  def show(x: a): foreign.C.String
}

let printf[a](x: a) where [Show[a]]: i32 = printStr(show[a](x))

impl Show[i32] {
  def show = λx: i32. intToStr(x)
}

impl Show[foreign.C.String] {
  def show = identity[foreign.C.String]
}

impl[a] Show[Maybe[a]] where [Show[a]] {
  def show = λm: Maybe[a]. match m with
    | Nothing -> "Nothing"
    | Just(x) -> show[a](x)
}

trait Monad[m: * → *] {
  def ret[a](x: a): m[a]
  def bind[a][b](v: m[a])(f: a → m[b]): m[b]
}

impl Monad[Maybe] {
  def ret[a](x:a): m[a] = Just[a](x)
  def bind[a][b](m: Maybe[a])(f: a → Maybe[b]): Maybe[b] = match m with
    | Nothing -> Nothing[b]
    | Just(x) -> f(x)
}

let safeDiv(x: i32)(y: i32): Maybe[i32] =
  if y == 0 then Nothing[i32] else Just[i32](x / y)

let compute(): Maybe[i32] =
  bind[Maybe][i32][i32](safeDiv(120)(5))(λstep1: i32.
    bind[Maybe][i32][i32](safeDiv(step1)(3))(λstep2: i32.
      ret[Maybe][i32](step2 + 1)))

let main(): i32 = {
  printf[foreign.C.String](`result = {compute()}\n`);
  0
}