import "stdlib/operators"
import "stdlib/functor"

let printInt: foreign.C.String → i32 → i32 = foreign[foreign.C.String → i32 → i32] printf
let printStr: foreign.C.String → i32 = foreign[foreign.C.String → i32] printf

data Maybe[a] =
  | Nothing
  | Just(a)

trait Monad[m: * → *] {
  def ret[a](x: a): m[a]
  def bind[a][b](v: m[a])(f: a → m[b]): m[b]
}

impl Monad[Maybe] {
  def ret[a](x:a): m[a] = Just[a](x)
  def bind[a][b](m: Maybe[a])(f: a → Maybe[b]): Maybe[b] = match m with
    | Nothing -> Nothing[b]
    | Just(x) -> f(x)
}

let safeDiv(x: i32)(y: i32): Maybe[i32] =
  if y == 0 then Nothing[i32] else Just[i32](x / y)

let compute(): Maybe[i32] =
  bind[Maybe][i32][i32](safeDiv(120)(5))(λstep1: i32.
    bind[Maybe][i32][i32](safeDiv(step1)(3))(λstep2: i32.
      ret[Maybe][i32](step2 + 1)))

let main(): i32 =
  match compute() with
    | Nothing -> printStr("result = nothing\n")
    | Just(r) -> printInt("result = %d\n")(r)
