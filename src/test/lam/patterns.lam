// match のパターン: 入れ子の構成子、リテラル（数・文字・bool・文字列・負の数）、変数、_、選択肢（|）、条件（if）。
// 期待する出力は EndToEndSuite に書いてある。

import "std/operators"

let printInt: i32 → i32 = foreign[i32 → i32] print_int

// 文字列のリテラルのパターンは == で比べるので、Eq のインスタンスが要る
impl Eq[foreign.C.String] {
  def eq(x: foreign.C.String)(y: foreign.C.String): bool = (foreign[foreign.C.String → foreign.C.String → bool] string_equal)(x)(y)
}

data Option[a] = { None, Some(a) }
rec data List[a] = { Nil, Cons(a)(List[a]) }
data Pair[a][b] = { MkPair(a)(b) }

let describe(n: i32): i32 = match n {
  0 => 100
  1 => 101
  other => other
}

let both(a: bool)(b: bool): i32 = match MkPair[bool][bool](a)(b) {
  MkPair(true)(true) => 3
  MkPair(true)(false) => 2
  MkPair(false)(true) => 1
  MkPair(false)(false) => 0
}

let firstTwo(xs: List[i32]): i32 = match xs {
  Cons(x)(Cons(y)(_)) => x * 10 + y
  Cons(x)(Nil) => x
  Nil => 0 - 1
}

rec let zip(xs: List[i32])(ys: List[i32]): i32 = match MkPair[List[i32]][List[i32]](xs)(ys) {
  MkPair(Cons(x)(xt))(Cons(y)(yt)) => x * y + zip(xt)(yt)
  _ => 0
}

let unwrap(o: Option[Option[i32]]): i32 = match o {
  Some(Some(0)) => 1000
  Some(Some(n)) => n
  Some(None) => 0 - 1
  None => 0 - 2
}

let letter(c: char): i32 = match c {
  'a' => 1
  'b' => 2
  _ => 0
}

let whole(o: Option[i32]): i32 = match o {
  x => match x {
    Some(v) => v
    None => 7
  }
}

let sign(n: i32): i32 = match n {
  -1 => 10
  0 => 20
  m if m < 0 => 30
  _ => 40
}

let greeting(s: foreign.C.String): i32 = match s {
  "hello" => 1
  "bye" | "goodbye" => 2
  _ => 0
}

let small(o: Option[i32]): i32 = match o {
  Some(1 | 2 | 3) => 1
  Some(n) if n > 100 => 2
  Some(_) | None => 3
}

let pick(p: Pair[Option[i32]][i32]): i32 = match p {
  MkPair(Some(x))(_) | MkPair(None)(x) => x
}

let classify(xs: List[i32])(x: i32): i32 = match xs {
  Cons(h)(_) if h == x => 1
  Cons(_)(Cons(h)(_)) if h == x => 2
  _ => x
}

let list(a: i32)(b: i32)(c: i32): List[i32] = Cons[i32](a)(Cons[i32](b)(Cons[i32](c)(Nil[i32])))

let main(): i32 = {
  printInt(describe(0));
  printInt(describe(1));
  printInt(describe(42));
  printInt(both(true)(false));
  printInt(both(false)(false));
  printInt(firstTwo(list(1)(2)(3)));
  printInt(firstTwo(Cons[i32](5)(Nil[i32])));
  printInt(firstTwo(Nil[i32]));
  printInt(zip(list(1)(2)(3))(list(4)(5)(6)));
  printInt(unwrap(Some[Option[i32]](Some[i32](0))));
  printInt(unwrap(Some[Option[i32]](Some[i32](9))));
  printInt(unwrap(Some[Option[i32]](None[i32])));
  printInt(unwrap(None[Option[i32]]));
  printInt(letter('b'));
  printInt(letter('z'));
  printInt(whole(None[i32]));
  printInt(sign(0 - 1));
  printInt(sign(0));
  printInt(sign(0 - 5));
  printInt(sign(5));
  printInt(greeting("hello"));
  printInt(greeting("goodbye"));
  printInt(greeting("what"));
  printInt(small(Some[i32](2)));
  printInt(small(Some[i32](500)));
  printInt(small(Some[i32](50)));
  printInt(small(None[i32]));
  printInt(pick(MkPair[Option[i32]][i32](Some[i32](7))(8)));
  printInt(pick(MkPair[Option[i32]][i32](None[i32])(8)));
  printInt(classify(list(1)(2)(3))(1));
  printInt(classify(list(1)(2)(3))(2));
  printInt(classify(list(1)(2)(3))(3));
  0
}
