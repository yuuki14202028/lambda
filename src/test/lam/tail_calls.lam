// 末尾呼び出し: 末尾位置の呼び出しはジャンプになるので、深い末尾再帰でもスタックを消費しない。
// 期待する出力は EndToEndSuite に書いてある。

import "std/operators"
import "std/list"

let printInt: i32 → i32 = foreign[i32 → i32] print_int

rec let count(n: i32)(acc: i32): i32 = if n == 0 then acc else count(n - 1)(acc + 1)

rec let build(n: i32)(acc: List[i32]): List[i32] = if n == 0 then acc else build(n - 1)(Cons[i32](n)(acc))

rec let sum(xs: List[i32])(acc: i32): i32 = match xs {
  Nil => acc
  Cons(x)(rest) => sum(rest)(acc + x)
}

let parity(n: i32): i32 =
  rec let go(k: i32)(even: bool): i32 =
    if k == 0 then (if even then 0 else 1) else go(k - 1)(!even)
  in go(n)(true)

rec let keep(n: i32): i32 = let unused: i32 = 10 in (λk: i32. n)(unused)

rec let spin(n: i32): i32 = if intrinsic[eq_i32](n)(0) then 7 else spin(intrinsic[sub_i32](n)(1))

let main(): i32 = {
  printInt(count(1000000)(0));
  printInt(sum(build(300000)(Nil[i32]))(0));
  printInt(parity(1000001));
  printInt(keep(42));
  printInt(spin(1000000));
  0
}
