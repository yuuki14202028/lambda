// derive Traversable: リスト・入れ子の再帰を持つ木・Option を traverse し、Option / Either の効果で打ち切る。
// 期待する出力は EndToEndSuite に書いてある。

import "std/operators"
import "std/option"
import "std/option_instances"
import "std/list"
import "std/list_instances"
import "std/either"
import "std/either_instances"
import "std/traversable"

let printInt: i32 → i32 = foreign[i32 → i32] print_int

let halve(x: i32): Option[i32] = if x % 2 == 0 then Some[i32](x / 2) else None[i32]

let sum(xs: List[i32]): i32 = foldLeft[List][i32][i32](λacc: i32. λx: i32. acc + x)(0)(xs)

let score(xs: List[i32]): i32 = match traverse[List][Option][i32][i32](halve)(xs) {
  None => 0 - 1
  Some(ys) => sum(ys)
}

rec data Rose[a] = { Node(a)(List[Rose[a]]) }

derive Functor[Rose]
derive Foldable[Rose]
derive Traversable[Rose]

let leaf(x: i32): Rose[i32] = Node[i32](x)(Nil[Rose[i32]])

let rose(a: i32)(b: i32)(c: i32): Rose[i32] =
  Node[i32](a)(Cons[Rose[i32]](leaf(b))(Cons[Rose[i32]](Node[i32](c)(Cons[Rose[i32]](leaf(a))(Nil[Rose[i32]])))(Nil[Rose[i32]])))

let roseScore(t: Rose[i32]): i32 = match traverse[Rose][Option][i32][i32](halve)(t) {
  None => 0 - 1
  Some(halved) => foldLeft[Rose][i32][i32](λacc: i32. λx: i32. acc + x)(0)(halved)
}

let positive(x: i32): Either[i32][i32] = if x > 0 then Right[i32][i32](x * 2) else Left[i32][i32](x)

let firstBad(xs: List[i32]): i32 = match traverse[List][Either[i32]][i32][i32](positive)(xs) {
  Left(bad) => bad
  Right(ys) => sum(ys)
}

let optional(o: Option[i32]): i32 = match traverse[Option][Option][i32][i32](halve)(o) {
  Some(Some(n)) => n
  Some(None) => 100
  None => 0 - 1
}

let main(): i32 = {
  printInt(score(Cons[i32](2)(Cons[i32](4)(Cons[i32](6)(Nil[i32])))));
  printInt(score(Cons[i32](2)(Cons[i32](3)(Nil[i32]))));
  printInt(roseScore(rose(2)(4)(6)));
  printInt(roseScore(rose(2)(5)(6)));
  printInt(firstBad(Cons[i32](1)(Cons[i32](2)(Nil[i32]))));
  printInt(firstBad(Cons[i32](1)(Cons[i32](0 - 7)(Cons[i32](0 - 9)(Nil[i32])))));
  printInt(optional(Some[i32](8)));
  printInt(optional(None[i32]));
  printInt(optional(Some[i32](3)));
  0
}
