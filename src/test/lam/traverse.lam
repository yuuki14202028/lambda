// derive Traversable: リスト・入れ子の再帰を持つ木・Option を traverse し、Option / Either の効果で打ち切る。
// 期待する出力は EndToEndSuite に書いてある。

import "std/operators"
import "std/option"
import "std/option_instances"
import "std/list"
import "std/list_instances"
import "std/either"
import "std/either_instances"
import "std/traversable"

let printInt: i32 → i32 = foreign[i32 → i32] print_int

let halve(x: i32): Option[i32] = if x % 2 == 0 then Some[i32](x / 2) else None[i32]

let sum(xs: List[i32]): i32 = xs.foldLeft[i32](0)(λacc: i32. λx: i32. acc + x)

let score(xs: List[i32]): i32 = match xs.traverse[Option][i32](halve) {
  None => 0 - 1
  Some(ys) => sum(ys)
}

rec data Rose[a] = { Node(a)(List[Rose[a]]) }

derive Functor[Rose]
derive Foldable[Rose]
derive Traversable[Rose]

let leaf(x: i32): Rose[i32] = Node[i32](x)(Nil[Rose[i32]])

let rose(a: i32)(b: i32)(c: i32): Rose[i32] =
  Node[i32](a)([leaf(b), Node[i32](c)([leaf(a)])])

let roseScore(t: Rose[i32]): i32 = match t.traverse[Option][i32](halve) {
  None => 0 - 1
  Some(halved) => halved.foldLeft[i32](0)(λacc: i32. λx: i32. acc + x)
}

let positive(x: i32): Either[i32][i32] = if x > 0 then Right[i32][i32](x * 2) else Left[i32][i32](x)

let firstBad(xs: List[i32]): i32 = match xs.traverse[Either[i32]][i32](positive) {
  Left(bad) => bad
  Right(ys) => sum(ys)
}

let optional(o: Option[i32]): i32 = match o.traverse[Option][i32](halve) {
  Some(Some(n)) => n
  Some(None) => 100
  None => 0 - 1
}

let main(): i32 = {
  printInt(score([2, 4, 6]));
  printInt(score([2, 3]));
  printInt(roseScore(rose(2)(4)(6)));
  printInt(roseScore(rose(2)(5)(6)));
  printInt(firstBad([1, 2]));
  printInt(firstBad([1, 0 - 7, 0 - 9]));
  printInt(optional(Some[i32](8)));
  printInt(optional(None[i32]));
  printInt(optional(Some[i32](3)));
  0
}
