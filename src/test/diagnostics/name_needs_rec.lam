trait Add[a] { def add(x: a)(y: a): a }; infixl 6 + = add; impl Add[i32] { def add(a: i32)(b: i32): i32 = intrinsic[add_i32](a)(b) }
trait Eq[a] { def eq(x: a)(y: a): bool }; infix 4 == = eq; impl Eq[i32] { def eq(a: i32)(b: i32): bool = intrinsic[eq_i32](a)(b) }
let fact(n: i32): i32 = if n == 0 then 1 else n + fact(n)

let main(): i32 = fact(5)
