trait Add[a] { def add(x: a)(y: a): a }; operator + = add; impl Add[i32] { def add(a: i32)(b: i32): i32 = intrinsic[add_i32](a)(b) }
trait Eq[a] { def eq(x: a)(y: a): bool }; operator == = eq; impl Eq[i32] { def eq(a: i32)(b: i32): bool = intrinsic[eq_i32](a)(b) }
let counter: i32 = 1

let main(): i32 = countr + 1
