impl Eq[char] {
  def eq(x: char)(y: char): bool = intrinsic[eq_char](x)(y)
  def neq(x: char)(y: char): bool = intrinsic[neq_char](x)(y)
}

impl Eq[bool] {
  def eq(x: bool)(y: bool): bool = intrinsic[eq_bool](x)(y)
  def neq(x: bool)(y: bool): bool = intrinsic[neq_bool](x)(y)
}

impl Eq[unit] {
  def eq(x: unit)(y: unit): bool = true
}
