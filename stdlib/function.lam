import "std/pair"

let id[a](x: a): a = x

let const[a][b](_x: a)(y: b): b = y

let compose[a][b][c](f: b → c)(g: a → b): a → c = λx: a. f(g(x))

let flip[a][b][c](f: a → b → c): b → a → c = λx: b. λy: a. f(y)(x)

let curry[a][b][c](f: (a, b) → c): a → b → c =
  λx: a. λy: b. f((x, y))

let uncurry[a][b][c](f: a → b → c): (a, b) → c =
  λp: (a, b). match p {
    (x, y) => f(x)(y)
  }
