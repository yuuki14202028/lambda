import "std/option"
import "std/functor"
import "std/applicative"
import "std/pair"
import "std/monad"
import "std/foldable"
import "std/traversable"
import "std/semigroup"
import "std/monoid"
import "std/eq"
import "std/ord"

derive Functor[Option]
derive Foldable[Option]
derive Traversable[Option]

impl Applicative[Option] {
  def pure[a](x: a): Option[a] = Some[a](x)

  def apply[a][b](f: Option[a → b]): Option[a] → Option[b] =
    λopt: Option[a]. match Pair[Option[a → b]][Option[a]](f)(opt) {
      Pair(Some(g))(Some(x)) => Some[b](g(x))
      _ => None[b]
    }
}

impl Monad[Option] {
  def flatMap[a][b](v: Option[a])(f: a → Option[b]): Option[b] =
    match v {
      Some(x) => f(x)
      None => None[b]
    }
}

impl[a] Semigroup[Option[a]] {
  def append(x: Option[a])(y: Option[a]): Option[a] = match x {
    Some(_) => x
    None => y
  }
}

impl[a] Monoid[Option[a]] {
  def empty: Option[a] = None[a]
}

derive Eq[Option]

// None は Some より前（構成子の宣言順と逆なので、導出せずに書く）
impl[a] Ord[Option[a]] with Ord[a] {
  def lt(x: Option[a])(y: Option[a]): bool = match Pair[Option[a]][Option[a]](x)(y) {
    Pair(Some(l))(Some(r)) => lt[a](l)(r)
    Pair(None)(Some(_)) => true
    _ => false
  }
}
