// リスト。関数は module List にあり、どれもリストを最初の引数に取るので、xs.length や xs.take(2) のように書ける。
// map などの trait のメソッドも、trait とインスタンス（std/list_instances）をスコープに入れれば xs.map[b](f) と書ける。

import "std/operators"
import "std/option"
import "std/pair"
import "std/eq"
import "std/ord"

rec data List[a] = { Nil, Cons(a)(List[a]) }

// [1, 2, 3] は Cons[i32](1)(Cons[i32](2)(Cons[i32](3)(Nil[i32])))（要素の型は最初の要素の型）
literal [] = Nil, Cons

module List {
  // 2 つのリストをつなぐ（Semigroup の append と同じ）
  rec let concat[a](xs: List[a])(ys: List[a]): List[a] = match xs {
    Nil => ys
    Cons(x)(rest) => Cons[a](x)(concat[a](rest)(ys))
  }

  rec let length[a](xs: List[a]): i32 = match xs {
    Nil => 0
    Cons(_)(rest) => length[a](rest) + 1
  }

  let isEmpty[a](xs: List[a]): bool = match xs {
    Nil => true
    _ => false
  }

  let reverse[a](xs: List[a]): List[a] =
    rec let go(acc: List[a])(l: List[a]): List[a] = match l {
      Nil => acc
      Cons(x)(rest) => go(Cons[a](x)(acc))(rest)
    } in go(Nil[a])(xs)

  // ---- 絞り込む ----
  // map / flatMap / foldLeft / foldRight は trait（Functor / Monad / Foldable）のメソッドで、xs.map[b](f) のように呼べる

  rec let filter[a](xs: List[a])(test: a → bool): List[a] = match xs {
    Nil => Nil[a]
    Cons(x)(rest) => if test(x) then Cons[a](x)(filter[a](rest)(test)) else filter[a](rest)(test)
  }

  // ---- 取り出す ----

  let head[a](xs: List[a]): Option[a] = match xs {
    Nil => None[a]
    Cons(x)(_) => Some[a](x)
  }

  let tail[a](xs: List[a]): Option[List[a]] = match xs {
    Nil => None[List[a]]
    Cons(_)(rest) => Some[List[a]](rest)
  }

  rec let last[a](xs: List[a]): Option[a] = match xs {
    Nil => None[a]
    Cons(x)(Nil) => Some[a](x)
    Cons(_)(rest) => last[a](rest)
  }

  // index 番目（0 から数える）。範囲の外は None
  rec let nth[a](xs: List[a])(index: i32): Option[a] = match xs {
    Nil => None[a]
    Cons(x)(rest) => if index == 0 then Some[a](x) else nth[a](rest)(index - 1)
  }

  // 先頭の count 個
  rec let take[a](xs: List[a])(count: i32): List[a] = match xs {
    Cons(x)(rest) if count > 0 => Cons[a](x)(take[a](rest)(count - 1))
    _ => Nil[a]
  }

  // 先頭の count 個を除いた残り
  rec let drop[a](xs: List[a])(count: i32): List[a] = match xs {
    Cons(_)(rest) if count > 0 => drop[a](rest)(count - 1)
    _ => xs
  }

  // ---- 探す ----

  // 条件を満たす最初の要素
  rec let find[a](xs: List[a])(test: a → bool): Option[a] = match xs {
    Nil => None[a]
    Cons(x)(_) if test(x) => Some[a](x)
    Cons(_)(rest) => find[a](rest)(test)
  }

  rec let any[a](xs: List[a])(test: a → bool): bool = match xs {
    Nil => false
    Cons(x)(rest) => test(x) || any[a](rest)(test)
  }

  rec let all[a](xs: List[a])(test: a → bool): bool = match xs {
    Nil => true
    Cons(x)(rest) => test(x) && all[a](rest)(test)
  }

  let contains[a](xs: List[a])(x: a): bool with Eq[a] = any[a](xs)(λy: a. x == y)

  // ---- 組み合わせる ----

  // 2 つのリストの要素を順に組にする。長さは短いほうに合わせる
  rec let zipWith[a][b][c](xs: List[a])(ys: List[b])(f: a → b → c): List[c] = match (xs, ys) {
    (Cons(x)(xt), Cons(y)(yt)) => Cons[c](f(x)(y))(zipWith[a][b][c](xt)(yt)(f))
    _ => Nil[c]
  }

  let zip[a][b](xs: List[a])(ys: List[b]): List[(a, b)] =
    zipWith[a][b][(a, b)](xs)(ys)(λx: a. λy: b. (x, y))

  // リストのリストを 1 つにつなぐ
  rec let flatten[a](xss: List[List[a]]): List[a] = match xss {
    Nil => Nil[a]
    Cons(xs)(rest) => concat[a](xs)(flatten[a](rest))
  }

  // ---- 整列 ----

  // 整列済みのリストに 1 つ挿入する
  private rec let insert[a](sorted: List[a])(x: a): List[a] with Ord[a] = match sorted {
    Nil => Cons[a](x)(Nil[a])
    Cons(y)(rest) => if x < y then Cons[a](x)(sorted) else Cons[a](y)(insert[a](rest)(x))
  }

  // 小さい順に並べる（同じ値の順は保つ）
  rec let sorted[a](xs: List[a]): List[a] with Ord[a] = match xs {
    Nil => Nil[a]
    Cons(x)(rest) => insert[a](sorted[a](rest))(x)
  }

  // ---- 集計 ----

  rec let sum(xs: List[i32]): i32 = match xs {
    Nil => 0
    Cons(x)(rest) => x + sum(rest)
  }

  rec let product(xs: List[i32]): i32 = match xs {
    Nil => 1
    Cons(x)(rest) => x * product(rest)
  }

  // 条件を満たす要素の数
  rec let count[a](xs: List[a])(test: a → bool): i32 = match xs {
    Nil => 0
    Cons(x)(rest) => (if test(x) then 1 else 0) + count[a](rest)(test)
  }

  // better(x)(y) が真なら x を選びながら、best から残りを見ていく
  private rec let pick[a](best: a)(rest: List[a])(better: a → a → bool): a = match rest {
    Nil => best
    Cons(x)(more) => pick[a](if better(x)(best) then x else best)(more)(better)
  }

  let maximum[a](xs: List[a]): Option[a] with Ord[a] = match xs {
    Nil => None[a]
    Cons(x)(rest) => Some[a](pick[a](x)(rest)(λl: a. λr: a. l > r))
  }

  let minimum[a](xs: List[a]): Option[a] with Ord[a] = match xs {
    Nil => None[a]
    Cons(x)(rest) => Some[a](pick[a](x)(rest)(λl: a. λr: a. l < r))
  }

  // ---- 分ける・並べ直す ----

  // 条件を満たす要素と、満たさない要素（どちらも元の順）
  rec let partition[a](xs: List[a])(test: a → bool): (List[a], List[a]) = match xs {
    Nil => (Nil[a], Nil[a])
    Cons(x)(rest) => match partition[a](rest)(test) {
      (yes, no) => if test(x) then (Cons[a](x)(yes), no) else (yes, Cons[a](x)(no))
    }
  }

  private rec let insertBy[a][b](sorted: List[a])(x: a)(key: a → b): List[a] with Ord[b] = match sorted {
    Nil => Cons[a](x)(Nil[a])
    Cons(y)(rest) => if key(x) < key(y) then Cons[a](x)(sorted) else Cons[a](y)(insertBy[a][b](rest)(x)(key))
  }

  // key の小さい順に並べる（key が同じ要素の順は保つ）
  rec let sortBy[a][b](xs: List[a])(key: a → b): List[a] with Ord[b] = match xs {
    Nil => Nil[a]
    Cons(x)(rest) => insertBy[a][b](sortBy[a][b](rest)(key))(x)(key)
  }

  // x が最初に現れる位置（0 から数える）
  let indexOf[a](xs: List[a])(x: a): Option[i32] with Eq[a] =
    rec let from(ys: List[a])(index: i32): Option[i32] = match ys {
      Nil => None[i32]
      Cons(y)(rest) => if y == x then Some[i32](index) else from(rest)(index + 1)
    } in from(xs)(0)

  // 重複を除く（最初に現れたものを残す）
  let unique[a](xs: List[a]): List[a] with Eq[a] =
    rec let go(seen: List[a])(ys: List[a]): List[a] = match ys {
      Nil => Nil[a]
      Cons(y)(rest) => if contains[a](seen)(y) then go(seen)(rest) else Cons[a](y)(go(Cons[a](y)(seen))(rest))
    } in go(Nil[a])(xs)

  // 要素の間に sep を挟む
  rec let intersperse[a](xs: List[a])(sep: a): List[a] = match xs {
    Cons(x)(Cons(y)(rest)) => Cons[a](x)(Cons[a](sep)(intersperse[a](Cons[a](y)(rest))(sep)))
    _ => xs
  }

  // ---- 作る ----

  // low 以上 high 未満の整数
  let range(low: i32)(high: i32): List[i32] =
    rec let from(n: i32)(acc: List[i32]): List[i32] = if n < low then acc else from(n - 1)(Cons[i32](n)(acc)) in
    from(high - 1)(Nil[i32])
}
