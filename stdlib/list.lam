import "std/operators"
import "std/option"

data rec List[a] = { Nil, Cons(a)(List[a]) }

let rec appendList[a](xs: List[a])(ys: List[a]): List[a] = match xs {
  Nil => ys
  Cons(x)(rest) => Cons[a](x)(appendList[a](rest)(ys))
}

let rec length[a](xs: List[a]): usize = match xs {
  Nil => 0usize
  Cons(_)(rest) => __add_usize(length[a](rest))(1usize)
}

let reverse[a](xs: List[a]): List[a] =
  let rec go(acc: List[a])(l: List[a]): List[a] = match l {
    Nil => acc
    Cons(x)(rest) => go(Cons[a](x)(acc))(rest)
  } in go(Nil[a])(xs)

let rec filter[a](p: a → bool)(xs: List[a]): List[a] = match xs {
  Nil => Nil[a]
  Cons(x)(rest) => if p(x) then Cons[a](x)(filter[a](p)(rest)) else filter[a](p)(rest)
}

let head[a](xs: List[a]): Option[a] = match xs {
  Nil => None[a]
  Cons(x)(_) => Some[a](x)
}

let tail[a](xs: List[a]): Option[List[a]] = match xs {
  Nil => None[List[a]]
  Cons(_)(rest) => Some[List[a]](rest)
}
