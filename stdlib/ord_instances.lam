import "std/operators"
import "std/ord"
import "std/eq"
import "std/eq_instances"

impl Ord[i8] {
  def lt(x: i8)(y: i8): bool = __lt_i8(x)(y)
  def leq(x: i8)(y: i8): bool = __leq_i8(x)(y)
  def gt(x: i8)(y: i8): bool = __gt_i8(x)(y)
  def geq(x: i8)(y: i8): bool = __geq_i8(x)(y)
}

