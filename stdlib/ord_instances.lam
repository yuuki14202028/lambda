// 組み込みの数値型の Ord。

import "std/eq"
import "std/eq_instances"
import "std/ord"

impl Ord[f32] {
  def lt(x: f32)(y: f32): bool = intrinsic[lt_f32](x)(y)
  def leq(x: f32)(y: f32): bool = intrinsic[leq_f32](x)(y)
  def gt(x: f32)(y: f32): bool = intrinsic[gt_f32](x)(y)
  def geq(x: f32)(y: f32): bool = intrinsic[geq_f32](x)(y)
}

