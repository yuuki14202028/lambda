// 演算子。
//
// 演算子は、宣言された多相関数を、左の値の型で具体化して呼ぶ書き方である:
// `operator + = add` の後では、`a + b` は `add[T](a)(b)`（T は a の型）。
// ここでは、演算子ごとの trait と、その宣言と、組み込みの型のインスタンスを定義する。
// 自分の型に演算子を使うには、その trait のインスタンスを書く（`impl Add[Money] { def add … }`）。
//
// `==` `!=` は std/eq、`<` `<=` `>` `>=` は std/ord にある。`&&` と `||` は bool 専用の組み込みで、宣言はない。

import "std/eq"
import "std/eq_instances"
import "std/ord"
import "std/ord_instances"

trait Add[a] {
  def add(x: a)(y: a): a
}

trait Sub[a] {
  def sub(x: a)(y: a): a
}

trait Mul[a] {
  def mul(x: a)(y: a): a
}

trait Div[a] {
  def div(x: a)(y: a): a
}

trait Mod[a] {
  def mod(x: a)(y: a): a
}

trait Neg[a] {
  def neg(x: a): a
}

trait Not[a] {
  def not(x: a): a
}

trait BitAnd[a] {
  def bitAnd(x: a)(y: a): a
}

trait BitOr[a] {
  def bitOr(x: a)(y: a): a
}

trait BitXor[a] {
  def bitXor(x: a)(y: a): a
}

operator + = add
operator - = sub
operator * = mul
operator / = div
operator % = mod
operator & = bitAnd
operator | = bitOr
operator ^ = bitXor
prefix operator - = neg
prefix operator ! = not

impl Add[f32] {
  def add(x: f32)(y: f32): f32 = intrinsic[add_f32](x)(y)
}

impl Sub[f32] {
  def sub(x: f32)(y: f32): f32 = intrinsic[sub_f32](x)(y)
}

impl Mul[f32] {
  def mul(x: f32)(y: f32): f32 = intrinsic[mul_f32](x)(y)
}

impl Div[f32] {
  def div(x: f32)(y: f32): f32 = intrinsic[div_f32](x)(y)
}

impl BitAnd[f32] {
  def bitAnd(x: f32)(y: f32): f32 = intrinsic[and_f32](x)(y)
}

impl BitOr[f32] {
  def bitOr(x: f32)(y: f32): f32 = intrinsic[or_f32](x)(y)
}

impl BitXor[f32] {
  def bitXor(x: f32)(y: f32): f32 = intrinsic[xor_f32](x)(y)
}

impl Neg[f32] {
  def neg(x: f32): f32 = intrinsic[neg_f32](x)
}

