import "std/list"
import "std/functor"
import "std/foldable"
import "std/traversable"
import "std/applicative"
import "std/monad"
import "std/semigroup"
import "std/monoid"
import "std/operators"
import "std/pair"
import "std/eq"
import "std/ord"

derive Functor[List]
derive Foldable[List]
derive Traversable[List]

impl Applicative[List] {
  def pure[a](x: a): List[a] = Cons[a](x)(Nil[a])

  // 関数と値のすべての組み合わせ
  def apply[a][b](fs: List[a → b]): List[a] → List[b] =
    λxs: List[a]. List.flatten[b](map[List][a → b][List[b]](fs)(λf: a → b. map[List][a][b](xs)(f)))
}

impl Monad[List] {
  def flatMap[a][b](xs: List[a])(f: a → List[b]): List[b] = List.flatten[b](map[List][a][List[b]](xs)(f))
}

impl[t] Semigroup[List[t]] {
  def append(xs: List[t])(ys: List[t]): List[t] = List.concat[t](xs)(ys)
}

impl[t] Monoid[List[t]] {
  def empty: List[t] = Nil[t]
}

// 要素を先頭から順に比べる（辞書順）。短いほうが前
rec impl[a] Eq[List[a]] with Eq[a] {
  def eq(xs: List[a])(ys: List[a]): bool = match Pair[List[a]][List[a]](xs)(ys) {
    Pair(Nil)(Nil) => true
    Pair(Cons(x)(xt))(Cons(y)(yt)) => eq[a](x)(y) && eq[List[a]](xt)(yt)
    _ => false
  }
}

rec impl[a] Ord[List[a]] with Ord[a] {
  def lt(xs: List[a])(ys: List[a]): bool = match Pair[List[a]][List[a]](xs)(ys) {
    Pair(Nil)(Cons(_)(_)) => true
    Pair(Cons(x)(xt))(Cons(y)(yt)) => lt[a](x)(y) || (eq[a](x)(y) && lt[List[a]](xt)(yt))
    _ => false
  }
}
