import "std/either"
import "std/functor"
import "std/applicative"
import "std/foldable"
import "std/traversable"
import "std/pair"
import "std/eq"
import "std/ord"

derive Functor[Either]
derive Foldable[Either]
derive Traversable[Either]

impl[b] Applicative[Either[b]] {
  def pure[a](x: a): Either[b][a] = Right[b][a](x)

  def apply[a][c](f: Either[b][a → c]): Either[b][a] → Either[b][c] =
    λe: Either[b][a]. match Pair[Either[b][a → c]][Either[b][a]](f)(e) {
      Pair(Left(err))(_) => Left[b][c](err)
      Pair(Right(_))(Left(err)) => Left[b][c](err)
      Pair(Right(g))(Right(x)) => Right[b][c](g(x))
    }
}

// Left は Right より前
impl[e][a] Eq[Either[e][a]] with Eq[e], Eq[a] {
  def eq(x: Either[e][a])(y: Either[e][a]): bool = match Pair[Either[e][a]][Either[e][a]](x)(y) {
    Pair(Left(l))(Left(r)) => eq[e](l)(r)
    Pair(Right(l))(Right(r)) => eq[a](l)(r)
    _ => false
  }
}

impl[e][a] Ord[Either[e][a]] with Ord[e], Ord[a] {
  def lt(x: Either[e][a])(y: Either[e][a]): bool = match Pair[Either[e][a]][Either[e][a]](x)(y) {
    Pair(Left(l))(Left(r)) => lt[e](l)(r)
    Pair(Right(l))(Right(r)) => lt[a](l)(r)
    Pair(Left(_))(Right(_)) => true
    Pair(Right(_))(Left(_)) => false
  }
}
