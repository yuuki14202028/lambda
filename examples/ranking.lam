// 成績の集計: 並べ替えの順序を、インスタンスの辞書として作って差し替える。
//
// 整列の関数は Ord[a] を要求するだけで、どの順序で並べるかは呼び出し側が決める:
// 解決に任せる（数の昇順）、辞書を渡す（(with d)）、式の中で差し替える（using d in …）。

import "std/prelude"

// ---- 順序の辞書を作る道具 ----

module Ordering {
  // 「前に来るか」の関数から Ord の辞書を作る。
  // impl の式は、インスタンスとして登録しない辞書の値。書かなかったメソッド（neq や leq など）はデフォルトで埋まる
  let fromBefore[a](before: a → a → bool): Ord[a] =
    // Ord はスーパークラスに Eq を持つので、先に Eq の辞書を作ってスコープに入れる
    using (impl Eq[a] {
      def eq(x: a)(y: a): bool = !before(x)(y) && !before(y)(x)
    }) in impl Ord[a] {
      def lt = before
    }

  // 値から取り出したキーの順序で比べる
  let by[a][k](key: a → k): Ord[a] with Ord[k] = fromBefore[a](λx: a. λy: a. lt[k](key(x))(key(y)))

  // 逆順
  let reversed[a](order: Ord[a]): Ord[a] = fromBefore[a](λx: a. λy: a. lt[a](with order)(y)(x))

  // 先に first で比べ、同じなら second で比べる
  let thenBy[a](first: Ord[a])(second: Ord[a]): Ord[a] = fromBefore[a](λx: a. λy: a.
    lt[a](with first)(x)(y) || (!lt[a](with first)(y)(x) && lt[a](with second)(x)(y)))
}

// ---- 成績 ----

module Grades {
  // 名前を付けたフィールドは、s.name のように読める（Student の module の関数になる）
  data Student = { MkStudent(name: String)(math: i32)(english: i32) }

  // 型の module に関数を足すと、同じ書き方で呼べる
  module Student {
    let total(s: Student): i32 = s.math + s.english
  }

  impl Show[Student] {
    def show = λs: Student. `{s.name} ({s.math}, {s.english})`
  }

  // 点数は 0 から 100 まで
  let valid(score: i32): Option[i32] = if score >= 0 && score <= 100 then Some[i32](score) else None[i32]

  module Summary {
    // 名前と、何かの値（合計や平均など）の組。値について map / fold / traverse できる
    data Scored[a] = { MkScored(String)(a) }

    derive Functor[Scored]
    derive Foldable[Scored]
    derive Traversable[Scored]

    impl[a] Show[Scored[a]] with Show[a] {
      def show = λs: Scored[a]. match s { MkScored(label)(value) => `{label}: {value}` }
    }

    let of(s: Student): Scored[i32] = MkScored[i32](s.name)(s.total)
  }
}

open Ordering
open Grades

let students: List[Student] =
  [
    MkStudent("carol")(70)(90),
    MkStudent("alice")(85)(75),
    MkStudent("dave")(85)(60),
    MkStudent("bob")(50)(95)
  ]

// フィールドを読む関数は普通の関数なので、そのまま渡せる
let byName: Ord[Student] = by[Student][String](Student.name)
let byMath: Ord[Student] = by[Student][i32](Student.math)
let byTotal: Ord[Student] = by[Student][i32](Student.total)

let main(): i32 = {
  // 解決に任せる: 数の昇順（xs.sorted は List.sorted[i32](xs)）
  display[List[i32]](students.map[i32](Student.total).sorted);
  // 辞書を渡す: 数の降順
  display[List[i32]](students.map[i32](Student.total).sorted(with reversed[i32](summon[Ord[i32]])));

  // Student にはインスタンスがないので、順序はその場で決める
  println("by name:");
  display[List[Student]](students.sorted(with byName));
  println("by total, highest first:");
  display[List[Student]](using reversed[Student](byTotal) in students.sorted);
  println("by math (highest first), then by name:");
  display[List[Student]](using thenBy[Student](reversed[Student](byMath))(byName) in students.sorted);
  println("best in english:");
  display[Option[Student]](using reversed[Student](by[Student][i32](Student.english)) in students.sorted.head);

  // 入れ子の module の型と、導出したインスタンス
  println("totals:");
  display[List[Summary.Scored[i32]]](students.map[Summary.Scored[i32]](Summary.of));
  display[Summary.Scored[bool]](Summary.of(MkStudent(name = "erin", math = 80, english = 80)).map[bool](λt: i32. t >= 150));
  // 点数の検査: 1 つでも範囲の外なら全体が None
  display[Option[List[i32]]](students.map[i32](Student.math).traverse[Option][i32](valid));
  display[Option[Summary.Scored[i32]]](Summary.of(MkStudent("frank")(90)(90)).traverse[Option][i32](valid));
  0
}
