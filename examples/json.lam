// JSON 風の値: 文字列から読み、整形して書き、中をたどる。
//
// 値は配列やオブジェクトの中に値を持つ（リストや組を通した再帰）。
// 読むほうは、文字列と位置を持ち回る手書きの再帰下降で、失敗は Option で表す。

import "std/prelude"

rec data Json = {
  JNull,
  JBool(bool),
  JNumber(i32),
  JString(String),
  JArray(List[Json]),
  JObject(List[(String, Json)])
}

// ---- 読む ----

module Reading {
  // 読んだ値と、次に読む位置
  type Step[a] = Option[(a, i32)]

  private let done[a](value: a)(next: i32): Step[a] = Some[(a, i32)]((value, next))

  // 空白を読み飛ばした位置
  private rec let skip(text: String)(at: i32): i32 = match text.charAt(at) {
    Some(c) if c.isSpace => skip(text)(at + 1)
    _ => at
  }

  // 決まった 1 文字（前の空白は読み飛ばす）
  private let expect(c: char)(text: String)(at: i32): Step[unit] = match text.charAt(skip(text)(at)) {
    Some(found) if found == c => done[unit](())(skip(text)(at) + 1)
    _ => None[(unit, i32)]
  }

  // 条件を満たす文字が続くかぎり読む
  private let span(test: char → bool)(text: String)(start: i32): (String, i32) =
    rec let stop(at: i32): i32 = match text.charAt(at) {
      Some(c) if test(c) => stop(at + 1)
      _ => at
    } in (text.slice(start)(stop(start) - start), stop(start))

  private let word(text: String)(at: i32): Step[String] = match span(char.isLetter)(text)(skip(text)(at)) {
    ("", _) => None[(String, i32)]
    (found, next) => done[String](found)(next)
  }

  private let number(text: String)(at: i32): Step[i32] = match span(char.isDigit)(text)(skip(text)(at)) {
    ("", _) => None[(i32, i32)]
    (digits, next) => done[i32](digits.toInt)(next)
  }

  // "…"（エスケープは扱わない）
  private let quoted(text: String)(at: i32): Step[String] = context[Option] {
    (_, start): (unit, i32) = expect('"')(text)(at);
    let (content, end): (String, i32) = span(λc: char. c != '"')(text)(start);
    (_, next): (unit, i32) = expect('"')(text)(end);
    (content, next)
  }

  rec {
    let value(text: String)(at: i32): Step[Json] = match text.charAt(skip(text)(at)) {
      Some('[') => items(text)(skip(text)(at) + 1)
      Some('{') => members(text)(skip(text)(at) + 1)
      Some('"') => context[Option] {
        (s, next): (String, i32) = quoted(text)(at);
        (JString(s), next)
      }
      Some(c) if c.isDigit => context[Option] {
        (n, next): (i32, i32) = number(text)(at);
        (JNumber(n), next)
      }
      _ => match word(text)(at) {
        Some(("null", next)) => done[Json](JNull)(next)
        Some(("true", next)) => done[Json](JBool(true))(next)
        Some(("false", next)) => done[Json](JBool(false))(next)
        _ => None[(Json, i32)]
      }
    }

    // 配列の中身: `[` の後から `]` まで
    let items(text: String)(at: i32): Step[Json] = match expect(']')(text)(at) {
      Some((_, next)) => done[Json](JArray(Nil[Json]))(next)
      None => context[Option] {
        (x, afterFirst): (Json, i32) = value(text)(at);
        (xs, next): (List[Json], i32) = moreItems(text)(afterFirst);
        (JArray(Cons[Json](x)(xs)), next)
      }
    }

    // `, 値` のくり返しと、閉じる `]`
    let moreItems(text: String)(at: i32): Step[List[Json]] = match expect(',')(text)(at) {
      None => context[Option] {
        (_, next): (unit, i32) = expect(']')(text)(at);
        (Nil[Json], next)
      }
      Some((_, afterComma)) => context[Option] {
        (item, afterItem): (Json, i32) = value(text)(afterComma);
        (others, next): (List[Json], i32) = moreItems(text)(afterItem);
        (Cons[Json](item)(others), next)
      }
    }

    // オブジェクトの中身: `{` の後から `}` まで（空でないものだけを扱う）
    let members(text: String)(at: i32): Step[Json] = context[Option] {
      (key, afterKey): (String, i32) = quoted(text)(at);
      (_, afterColon): (unit, i32) = expect(':')(text)(afterKey);
      (item, afterItem): (Json, i32) = value(text)(afterColon);
      // 残りのメンバー（なければ、閉じる `}`）
      (rest, next): (Json, i32) = match expect(',')(text)(afterItem) {
        Some((_, afterComma)) => members(text)(afterComma)
        None => context[Option] {
          (_, end): (unit, i32) = expect('}')(text)(afterItem);
          (JObject(Nil[(String, Json)]), end)
        }
      };
      let others: List[(String, Json)] = match rest {
        JObject(fields) => fields
        _ => Nil[(String, Json)]
      };
      (JObject(Cons[(String, Json)]((key, item))(others)), next)
    }
  }

  // 文字列全体が 1 つの値であること
  let read(text: String): Option[Json] = match value(text)(0) {
    Some((json, next)) if skip(text)(next) == text.length => Some[Json](json)
    _ => None[Json]
  }
}

// ---- 書く ----

// 1 行の表示。配列の中身は List の Show に任せるので、自身のインスタンスが要る
rec impl Show[Json] {
  def show = λj: Json. match j {
    JNull => "null"
    JBool(b) => show[bool](b)
    JNumber(n) => show[i32](n)
    JString(s) => `"{s}"`
    JArray(items) => show[List[Json]](items)
    JObject(fields) => `\{{fields.foldLeft[String]("")(λacc: String. λfield: (String, Json). match field {
      (key, value) => if acc == "" then `"{key}": {value}` else `{acc}, "{key}": {value}`
    })}\}`
  }
}

// ---- たどる ----

rec let field(key: String)(fields: List[(String, Json)]): Option[Json] = match fields {
  Nil => None[Json]
  Cons((found, value))(_) if found == key => Some[Json](value)
  Cons(_)(rest) => field(key)(rest)
}

// キーの列をたどる
rec let at(path: List[String])(j: Json): Option[Json] = match (path, j) {
  (Nil, _) => Some[Json](j)
  (Cons(key)(rest), JObject(fields)) => field(key)(fields).flatMap[Json](at(rest))
  _ => None[Json]
}

// 中にある数をすべて足す
rec let total(j: Json): i32 = match j {
  JNumber(n) => n
  JArray(items) => items.foldLeft[i32](0)(λacc: i32. λitem: Json. acc + total(item))
  JObject(fields) => fields.foldLeft[i32](0)(λacc: i32. λf: (String, Json). match f {
    (_, value) => acc + total(value)
  })
  JNull | JBool(_) | JString(_) => 0
}

let path(a: String)(b: String): List[String] = [a, b]

let report(text: String): unit = match Reading.read(text) {
  None => println(`cannot read: {text}`)
  Some(json) => println(`{json}  (total {total(json)})`)
}

let main(): i32 = {
  report("null");
  report(" [1, 2, [3, 4], true] ");
  report("{\"name\": \"lambda\", \"size\": 42}");
  report("{\"point\": {\"x\": 3, \"y\": 4}, \"tags\": [\"a\", \"b\"], \"ok\": false}");
  report("[1, 2");
  report("{\"a\": }");
  report("[1] 2");
  display[Option[Json]](Reading.read("{\"point\": {\"x\": 3, \"y\": 4}}").flatMap[Json](at(path("point")("y"))));
  display[Option[Json]](Reading.read("{\"point\": {\"x\": 3}}").flatMap[Json](at(path("point")("y"))));
  0
}
